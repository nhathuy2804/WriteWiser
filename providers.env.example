# Put these in your shell/hosting environment, never commit real API keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_PROVIDER_ORDER=gemini,groq,together,openrouter

# Descriptive User-Agent; this may help with provider-side request filtering but cannot override an upstream block.
WRITEWISER_USER_AGENT=WriteWiser/47 (IELTS Writing learning app; contact https://www.facebook.com/people/WriteWiser/61595026757886/)
# OpenRouter JSON stability: response healing + one retry only on malformed JSON.
OPENROUTER_RESPONSE_HEALING=1
OPENROUTER_JSON_RETRY=1
# Optional custom OpenAI-compatible endpoints. Keep API keys in separate environment variables.
# Example: CUSTOM_AI_PROVIDERS_JSON=[{"name":"deepseek","label":"DeepSeek","api_key_env":"DEEPSEEK_API_KEY","model_env":"DEEPSEEK_MODEL","endpoint":"https://api.deepseek.com/chat/completions","default_model":"deepseek-chat"}]
# Then define DEEPSEEK_API_KEY and DEEPSEEK_MODEL separately, and include deepseek in AI_PROVIDER_ORDER.
